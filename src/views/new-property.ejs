<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <h1>Nueva Propiedad</h1>
    <form action="/new" method="post" class="new-property">
        <label for="title">Title</label>
        <input type="text" id="title" name="title">
        <label for="address">Address</label>
        <input type="text" id="address" name="address">
        <label for="status">Status</label>
        <input type="text" id="status" name="status">
        <label for="price">Price Soles</label>
        <input type="text" id="price" name="price">
        <label for="units">Units</label>
        <input type="text" id="units" name="units">
        <label for="bedrooms">Bedrooms</label>
        <input type="text" id="bedrooms" name="bedrooms">
        <label for="area">Area</label>
        <input type="text" id="area" name="area">
        <label for="amenities">Amenities (separar por comas)</label>
        <input type="text" id="amenities" name="amenities">
        <label for="photo">Photo</label>
        <select id="photo" name="photo">
            <% photos.forEach(photo => { %>
                <option value="/upload/<%= photo %>"><%= photo %></option>
            <% }) %>
       </select>
        <div class="photos">
            <% photos.forEach(photo => { %>
                <figure>
                    <img src="/upload/<%= photo %>" class="photo">
                    <figcaption><%= photo %></figcaption>
                </figure>
            <% }) %>
        </div>
        <button type="submit">Crear propiedad</button>
    </form>
    
</body>
</html>
